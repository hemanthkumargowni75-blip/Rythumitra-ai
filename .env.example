# ==============================================================================
# RythuMitra AI — Production Environment Variables (.env.example)
# ==============================================================================

# Core Application Settings
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_APP_NAME="RythuMitra AI"
NEXT_PUBLIC_APP_URL=https://app.rythumitra.ai
NEXT_PUBLIC_API_URL=https://app.rythumitra.ai/api/v1

# Authentication & SMS OTP (2Factor.in)
TWOFACTOR_API_KEY=

# Generative AI (Google Gemini)
GEMINI_API_KEY=

# Database & Sessions
DATABASE_URL=
JWT_SECRET=
NEXTAUTH_SECRET=
SESSION_COOKIE_NAME=rm_session

# Agro-Climatic & Market Data APIs
WEATHER_API_KEY=
MARKET_API_KEY=

